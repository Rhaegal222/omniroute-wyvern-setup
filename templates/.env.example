# Configurazione base; i segreti vengono gestiti tramite Vault o variabili d'ambiente.
OMNIROUTE_VERSION=3.8.51
OPENCODE_OMNIROUTE_AUTH_VERSION=1.2.2
OMNIROUTE_IMAGE=wyrmrest/omniroute:3.8.51
OMNIROUTE_DATA_DIR=.omniroute
OMNIROUTE_BASE_URL=http://omniroute:20128/v1
OMNIROUTE_CHAT_ADMISSION_HEALTHY_HEADROOM=0
OMNIROUTE_CHAT_ADMISSION_QUEUE_MS=30000
OMNIROUTE_CHAT_ADMISSION_MAX_QUEUED_BYTES=8388608
VAULT_ADDR=http://vault:18200
OMNIROUTE_VAULT_AUTH_DIR=/run/vault/omniroute
OMNIROUTE_SECRETS_DIR=/run/secrets/omniroute
